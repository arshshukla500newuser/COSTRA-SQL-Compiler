digraph COSTRA {
  graph [rankdir=TB, bgcolor="#fffaf3", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Noto Sans", label="COSTRA | SQL compiler + estimated optimizer + separate SQLite execution", labelloc="t", fontsize=18, fontcolor="#432319"];
  node [shape=box, style="rounded,filled", fillcolor="#f2e6d7", color="#b86a50", penwidth=1.2, fontname="Noto Sans", fontsize=10, fontcolor="#432319", margin="0.14,0.09"];
  edge [color="#b86a50", penwidth=1.15, arrowsize=0.7];
  sql [label="SQL input", fillcolor="#bd503b", color="#bd503b", fontcolor="#fffaf3", fontsize=12];
  lexer [label="Lexer\nTokens + locations"];
  parser [label="Recursive-descent parser\nAST + normalized expressions"];
  semantic [label="Semantic validation\nTables, aliases, columns, aggregates"];
  ir [label="Logical relational IR\nScan · Join · Filter · Aggregate · Sort"];
  stats [label="Synthetic statistics\nSelectivity + cardinality estimates"];
  candidates [label="Candidate plans\nAccess paths + inner-join orders"];
  cost [label="Relative cost comparison\nChoose lowest estimated candidate"];
  reject [label="Readable diagnostic\nStop before execution", fillcolor="#f5d4cd", color="#bd503b"];
  format [label="Normalized SQL", fillcolor="#dfece5", color="#618c75"];
  sqlite [label="SQLite execution\nindependent planner", fillcolor="#dfece5", color="#618c75"];
  result [label="Result rows + EXPLAIN QUERY PLAN\n+ observed stage timings", fillcolor="#dfece5", color="#618c75"];
  output [label="COSTRA estimated plan + costs\n(relative model units, not ms)", fillcolor="#f2d9a7", color="#d49b38"];
  sql -> lexer -> parser -> semantic;
  semantic -> ir [label="valid"];
  semantic -> reject [label="invalid"];
  ir -> stats -> candidates -> cost -> output;
  semantic -> format [style=dashed, color="#618c75", label="validated AST"];
  format -> sqlite -> result;
  {rank=same; reject; ir;}
  {rank=same; output; result;}
}